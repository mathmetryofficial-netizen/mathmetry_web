# ==============================================================================
# Mathmetry Environment Variables Template (.env.example)
# Copy this file to .env.local and populate with your own values.
# ==============================================================================

# MongoDB Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority&ssl=true
MONGODB_URI=

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# Generate a secure 32-byte hex secret with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Razorpay API Credentials (Server-side)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Client-side Key ID (Must match RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
